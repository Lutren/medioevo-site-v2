---
interface Props {
  value: string | number;
  label: string;
  description: string;
}
const { value, label, description } = Astro.props;
---
<div class="text-center p-6 bg-card border border-border rounded-xl hover:border-primary/50 transition-colors">
  <div class="text-4xl lg:text-5xl font-bold text-foreground mb-2">{value}</div>
  <div class="text-lg font-medium text-foreground mb-1">{label}</div>
  <div class="text-sm text-muted-foreground">{description}</div>
</div>