---
interface Props {
  value: string;
  label: string;
  description?: string;
}
const { value, label, description } = Astro.props;
---

<div class="stat-card">
  <div class="stat-card__value">{value}</div>
  <div class="stat-card__label">{label}</div>
  {description && <div class="stat-card__desc">{description}</div>}
</div>