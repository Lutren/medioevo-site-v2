---
import Base from '../layouts/Base.astro';
import { repos, categories, GH_USER } from '../data/repos';
const byCat = categories.map((c) => ({ cat: c, items: repos.filter((r) => r.cat === c) }));
// JSON-LD: cada repo como SoftwareSourceCode para indexación por buscadores e IAs.
const ld = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Open Source - MEDIOEVO / OSIT',
  url: 'https://medioevo.space/open-source/',
  author: { '@type': 'Person', name: 'Luis René González', alternateName: 'Lutren', url: `https://github.com/${GH_USER}` },
  hasPart: repos.map((r) => ({
    '@type': 'SoftwareSourceCode',
    name: `${GH_USER}/${r.name}`,
    codeRepository: `https://github.com/${GH_USER}/${r.name}`,
    ...(r.lang ? { programmingLanguage: r.lang } : {}),
    description: r.desc,
  })),
};
---
<Base title="Open Source - MEDIOEVO / OSIT" description={`${repos.length} repositorios open source de Luis René González (Lutren): núcleo de evidencia, gates de acción, seguridad de agentes local-first, labs falsables y herramientas MEDIOEVO/OSIT.`}>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <h1 class="text-3xl font-bold text-gradient">Open Source</h1>
  <p class="text-[var(--mut)] mt-3 max-w-2xl">
    Filosofía <strong class="text-white">open-core</strong>: las <strong class="text-white">primitivas
    de evidencia</strong> (gates, calibración, seguridad de agentes, curaduría) son abiertas y refuerzan
    la ciencia y cualquiera puede auditarlas. El runtime completo, el kernel, la saga íntegra y las apps
    comerciales se mantienen protegidos para sostener el proyecto.
    <strong class="text-white">{repos.length} repositorios</strong> en
    <a href={`https://github.com/${GH_USER}`} class="text-[var(--acc)] hover:text-white transition-colors">github.com/{GH_USER}</a>.
  </p>

  {byCat.map((g) => (
    <section class="mt-10">
      <h2 class="text-xl font-semibold text-gradient mb-4">{g.cat}</h2>
      <div class="grid sm:grid-cols-2 gap-3">
        {g.items.map((r) => (
          <a href={`https://github.com/${GH_USER}/${r.name}`} target="_blank" rel="noopener" class="block border border-[var(--line)] rounded-xl p-4 no-underline hover:border-[rgba(124,196,255,0.3)] hover:shadow-[0_0_24px_rgba(124,196,255,0.06)] transition-all duration-250">
            <div class="flex items-center gap-2">
              <span class="text-white font-medium">{GH_USER}/{r.name}</span>
              {r.lang && <span class="text-xs text-[var(--acc)]">{r.lang}</span>}
            </div>
            <div class="text-[var(--mut)] text-sm mt-1">{r.desc}</div>
          </a>
        ))}
      </div>
    </section>
  ))}

    <div class="border border-[var(--line)] rounded-xl p-5 mt-10">
        <div class="text-white font-medium">¿Te sirve este trabajo?</div>
        <p class="text-[var(--mut)] text-sm mt-1">Apóyalo vía GitHub Sponsors o visita la <a href="/tienda" class="text-[var(--acc)] hover:text-white transition-colors">tienda</a> para libros y packs.</p>
        <a href={`https://github.com/sponsors/${GH_USER}`} target="_blank" rel="noopener" class="mt-3 inline-block border border-[var(--acc)] px-4 py-2 rounded-lg no-underline hover:bg-[var(--acc)] hover:text-[#0a0c10] transition-all">❤ GitHub Sponsors</a>
    </div>
    <p class="text-[var(--mut)] text-xs mt-6">Índice legible por máquinas: <a href="/llms.txt" class="text-[var(--acc)] hover:text-white transition-colors">/llms.txt</a></p>
</Base>
