---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Base.astro';

// Get character-related atlas docs
const atlasDocs = await getCollection('atlas');
const characters = atlasDocs.filter(d => 
  d.data.slug.includes('personaje') || 
  d.data.slug.includes('character')
);
---

<Layout 
  title="Personajes MEDIOEVO" 
  description="Leonardo, Faith, Darvi, Nico, Don Humo, ARCHON y más personajes del universo MEDIOEVO"
>
  <div class="min-h-screen bg-background">
    <!-- Header -->
    <header class="relative py-16 lg:py-24 overflow-hidden">
      <div class="container mx-auto px-4 max-w-6xl">
        <div class="text-center max-w-4xl mx-auto">
          <div class="inline-block px-4 py-1.5 rounded-full bg-surface2 border border-purple-500/20 text-purple-400 text-xs font-bold tracking-widest uppercase mb-6 animate-fade-in">
            Galería de Personajes
          </div>
          
          <h1 class="text-4xl lg:text-6xl font-serif font-bold text-center mb-6 hero-title animate-fade-in">
            Personajes <span class="text-gradient">MEDIOEVO</span>
          </h1>
          
          <p class="text-xl text-muted-foreground text-center max-w-2xl mx-auto hero-sub animate-fade-in-2">
            Conoce a los observadores, facciones y entidades del universo MEDIOEVO.
            <br class="hidden lg:block" />
            Desde Leonardo y Faith hasta ARCHON y Don Humo.
          </p>
        </div>
      </div>
      
      <!-- Background Glow -->
      <div class="absolute top-0 left-1/2 transform -translate-x-1/2 w-full max-w-4xl h-64 bg-gradient-to-b from-purple-500/5 to-pink-500/5 pointer-events-none"></div>
    </header>

    <!-- Characters Grid -->
    <main class="container mx-auto px-4 py-12 max-w-7xl">
      {characters.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {characters.map((doc, index) => (
            <div 
              class="wiki-card animate-fade-in"
              style={`animation-delay: ${Math.min(index * 100, 500)}ms;`}
            >
              <div class="flex items-center gap-4 mb-4">
                <div class="w-16 h-16 rounded-full bg-gradient-to-br from-purple-500 to-pink-500 flex items-center justify-center text-3xl">
                  👤
                </div>
                <div>
                  <h3 class="text-xl font-bold text-foreground">{doc.data.title}</h3>
                  <div class="text-sm text-muted-foreground">Documento de referencia</div>
                </div>
              </div>
              <a 
                href={`/wiki/atlas/${doc.data.slug}`}
                class="inline-flex items-center gap-2 text-purple-400 font-semibold hover:text-gold transition-colors"
              >
                Ver perfil completo
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </a>
            </div>
          ))}
        </div>
      ) : (
        <div class="text-center py-20">
          <div class="text-6xl mb-4">👥</div>
          <h3 class="text-2xl font-bold text-foreground mb-3">Personajes en Desarrollo</h3>
          <p class="text-muted-foreground max-w-md mx-auto mb-8">
            Los perfiles de personajes están siendo documentados. 
            Revisa el Atlas Dual para información sobre personajes y facciones.
          </p>
          <a 
            href="/wiki/atlas"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-gold text-bg font-bold hover:shadow-glow-gold transition-all"
          >
            Ver Atlas Dual
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
      )}

      <!-- Featured Characters -->
      <div class="mt-16">
        <h2 class="text-2xl font-serif font-bold text-foreground mb-6 text-center">Personajes Principales</h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          {['Leonardo', 'Faith', 'Darvi', 'Don Humo'].map((name, index) => (
            <div class="wiki-card text-center p-6 animate-fade-in" style={`animation-delay: ${index * 100}ms;`}>
              <div class="w-20 h-20 rounded-full bg-gradient-to-br from-gold to-purple-500 mx-auto mb-4 flex items-center justify-center text-4xl">
                👤
              </div>
              <div class="text-lg font-bold text-foreground">{name}</div>
              <div class="text-xs text-muted-foreground mt-1">Observador clave</div>
            </div>
          ))}
        </div>
      </div>
    </main>
  </div>
</Layout>