---
import { getSystems } from '../../../lib/medioevo';
import Layout from '../../../layouts/Base.astro';
import { marked } from 'marked';

export async function getStaticPaths() {
  const systems = await getSystems();
  return systems.map(s => ({
    params: { slug: s.data.slug },
  }));
}

const systems = await getSystems();
const system = systems.find(s => s.data.slug === Astro.params.slug);

if (!system) {
  return Astro.redirect('/wiki/systems');
}

const { data, body } = system;
const htmlContent = body ? marked.parse(body, { async: false }) : '';

// Schema.org structured data
const techArticleSchema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: data.title,
  author: {
    '@type': 'Person',
    name: 'Luis René González',
    alternateName: 'Lutren'
  },
  datePublished: '2024-01-01',
  dateModified: new Date().toISOString().split('T')[0],
  description: `Documentación técnica del sistema ${data.title}`,
  inLanguage: 'es',
  articleSection: 'Sistemas Epistémicos',
  publisher: {
    '@type': 'Organization',
    name: 'MEDIOEVO / OSIT',
    logo: {
      '@type': 'ImageObject',
      url: 'https://medioevo.space/favicon.svg'
    }
  }
};

// Breadcrumb schema
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Wiki',
      item: 'https://medioevo.space/wiki'
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Sistemas Epistémicos',
      item: 'https://medioevo.space/wiki/systems'
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: data.title
    }
  ]
};
---

<Layout 
  title={`Sistemas | ${data.title}`} 
  description={`Documentación técnica: ${data.title}`}
  image="/og-default.jpg"
>
  <script type="application/ld+json" set:html={JSON.stringify(techArticleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <div class="min-h-screen bg-background">
    <header class="py-8 lg:py-12 bg-gradient-to-b from-muted/20 to-background">
      <div class="container mx-auto px-4 max-w-4xl">
        <nav aria-label="Navegación principal" class="mb-6 text-sm text-muted-foreground">
          <a href="/wiki" class="hover:text-gold">Wiki</a> 
          <span aria-hidden="true"> / </span>
          <a href="/wiki/systems" class="hover:text-gold">Sistemas</a> 
          <span aria-hidden="true"> / </span>
          <span aria-current="page">{data.title}</span>
        </nav>
        <h1 class="text-3xl lg:text-4xl font-serif font-bold text-foreground">{data.title}</h1>
      </div>
    </header>

    <div class="container mx-auto px-4 py-12 max-w-4xl">
      <article class="prose-wiki max-w-none" aria-label="Documentación técnica">
        {htmlContent ? (
          <div class="markdown-body" set:html={htmlContent} />
        ) : (
          <div class="text-center py-12" role="status">
            <div class="text-6xl mb-4" aria-hidden="true">⚙️</div>
            <p class="text-muted-foreground text-lg">Documentación en desarrollo.</p>
          </div>
        )}
      </article>
    </div>
  </div>
</Layout>
