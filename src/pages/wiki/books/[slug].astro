---
import { getBook, getBooks } from '../../../lib/medioevo';
import Layout from '../../../layouts/Base.astro';
import { marked } from 'marked';

export async function getStaticPaths() {
  const books = await getBooks();
  return books.map(book => ({
    params: { slug: book.data.slug },
  }));
}

const book = await getBook(Astro.params.slug);

if (!book) {
  return Astro.redirect('/wiki/books');
}

const { data, body } = book;
const htmlContent = body ? marked.parse(body, { async: false }) : '';

// Get previous and next books
const allBooks = await getBooks();
const currentIndex = allBooks.findIndex(b => b.data.slug === data.slug);
const prevBook = currentIndex > 0 ? allBooks[currentIndex - 1] : null;
const nextBook = currentIndex < allBooks.length - 1 ? allBooks[currentIndex + 1] : null;

const statusColors: Record<string, { border: string; bg: string; text: string; label: string }> = {
  canon: { 
    border: 'rgba(74, 222, 128, 0.4)', 
    bg: 'rgba(74, 222, 128, 0.1)', 
    text: '#4ade80',
    label: 'CANON' 
  },
  fusion: { 
    border: 'rgba(212, 160, 80, 0.4)', 
    bg: 'rgba(212, 160, 80, 0.1)', 
    text: 'var(--gold)',
    label: 'FUSIÓN' 
  },
  especial: { 
    border: 'rgba(167, 139, 250, 0.4)', 
    bg: 'rgba(167, 139, 250, 0.1)', 
    text: '#a78bfa',
    label: 'ESPECIAL' 
  },
};

const status = statusColors[data.status] || statusColors.canon;

// Schema.org structured data
const bookSchema = {
  '@context': 'https://schema.org',
  '@type': 'Book',
  name: data.title,
  author: {
    '@type': 'Person',
    name: 'Luis René González',
    alternateName: 'Lutren'
  },
  datePublished: '2024-01-01', // placeholder
  description: data.logline,
  image: data.cover?.replace('/wiki/covers/', '/wiki/covers/webp/').replace('.jpg', '-800.webp') || '/wiki/covers/webp/placeholder-800.webp',
  inLanguage: 'es',
  bookFormat: 'EBook',
  genre: data.genre,
  numberOfPages: data.chapterCount ? String(data.chapterCount) : undefined,
  wordCount: data.wordCount ? String(data.wordCount) : undefined,
};

// Breadcrumb schema
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Wiki',
      item: 'https://medioevo.space/wiki'
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Biblioteca',
      item: 'https://medioevo.space/wiki/books'
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: data.title
    }
  ]
};
---

<Layout 
  title={`MEDIOEVO Wiki | ${data.title}`} 
  description={data.logline}
  image={data.cover?.replace('/wiki/covers/', '/wiki/covers/webp/').replace('.jpg', '-800.webp') || '/wiki/covers/webp/placeholder-800.webp'}
>
  <script type="application/ld+json" set:html={JSON.stringify(bookSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <div class="min-h-screen bg-background">
    <!-- Breadcrumbs -->
    <div class="bg-surface/50 border-b border-line">
      <div class="container mx-auto px-4 max-w-6xl py-4">
        <nav aria-label="Navegación principal" class="flex items-center gap-2 text-sm">
          <a href="/wiki" class="text-muted-foreground hover:text-gold transition-colors">Wiki</a>
          <span class="text-muted-foreground" aria-hidden="true">/</span>
          <a href="/wiki/books" class="text-muted-foreground hover:text-gold transition-colors">Biblioteca</a>
          <span class="text-muted-foreground" aria-hidden="true">/</span>
          <span class="text-gold font-semibold" aria-current="page">{data.title}</span>
        </nav>
      </div>
    </div>

    <!-- Header Section -->
    <header class="relative py-12 lg:py-16 overflow-hidden">
      <div class="container mx-auto px-4 max-w-6xl">
        <div class="flex flex-col lg:flex-row gap-8 lg:gap-12 items-start">
          <!-- Cover Image -->
          <div class="lg:w-72 flex-shrink-0">
            <div class="relative rounded-lg overflow-hidden shadow-2xl">
              <img 
                src={data.cover?.replace('/wiki/covers/', '/wiki/covers/webp/').replace('.jpg', '-800.webp') || '/wiki/covers/webp/placeholder-800.webp'}
                srcset={`
                  ${data.cover?.replace('/wiki/covers/', '/wiki/covers/webp/').replace('.jpg', '-400.webp') || '/wiki/covers/webp/placeholder-400.webp'} 400w,
                  ${data.cover?.replace('/wiki/covers/', '/wiki/covers/webp/').replace('.jpg', '-800.webp') || '/wiki/covers/webp/placeholder-800.webp'} 800w,
                  ${data.cover?.replace('/wiki/covers/', '/wiki/covers/webp/').replace('.jpg', '-1200.webp') || '/wiki/covers/webp/placeholder-1200.webp'} 1200w
                `}
                sizes="(max-width: 768px) 100vw, 384px"
                alt={`Portada del libro ${data.title}`}
                class="w-full aspect-[2/3] object-cover"
                width="800"
                height="1200"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent" aria-hidden="true"></div>
            </div>
          </div>

          <!-- Book Info -->
          <div class="flex-1 min-w-0">
            <!-- Status Badge -->
            <div class="flex flex-wrap items-center gap-3 mb-6" aria-label="Estado del libro">
              <span 
                class="px-4 py-2 rounded-full text-sm font-bold tracking-wider uppercase border shadow-sm"
                style={`background: ${status.bg}; color: ${status.text}; border-color: ${status.border};`}
              >
                {status.label}
              </span>
              {data.publicationBlock && (
                <span class="px-4 py-2 rounded-full text-sm font-bold tracking-wider uppercase bg-red-500/20 text-red-400 border border-red-500/40 flex items-center gap-2" aria-label="Publicación bloqueada">
                  <span aria-hidden="true">⚠️</span>
                  BLOQUEADO
                </span>
              )}
            </div>

            <!-- Title and Number -->
            <div class="flex items-baseline gap-4 mb-4">
              <span class="text-lg font-mono text-muted-foreground opacity-70" aria-label={`Libro número ${data.num}`}>#{String(data.num).padStart(2, '0')}</span>
              <h1 class="text-4xl lg:text-5xl font-serif font-bold text-foreground">{data.title}</h1>
            </div>

            <!-- Logline -->
            <p class="text-xl text-muted-foreground mb-6 leading-relaxed">{data.logline}</p>

            <!-- Constants -->
            {(data.constants || []).length > 0 && (
              <div class="mb-6" aria-label="Constantes canónicas del libro">
                <h2 class="text-sm font-semibold text-foreground mb-3 uppercase tracking-wider">Constantes Canónicas</h2>
                <div class="flex flex-wrap gap-2">
                  {(data.constants || []).map((c: string) => (
                    <span class="px-3 py-1.5 rounded bg-surface2 border border-line text-sm text-muted-foreground font-medium">{c}</span>
                  ))}
                </div>
              </div>
            )}

            <!-- Metadata Grid -->
            <dl class="grid grid-cols-2 md:grid-cols-4 gap-4 p-4 rounded-lg bg-surface/50 border border-line" aria-label="Metadatos del libro">
              <div>
                <dt class="text-xs text-muted-foreground uppercase tracking-wider mb-1">Palabras</dt>
                <dd class="text-xl font-bold text-gold">{data.wordCount?.toLocaleString() ?? '?'}</dd>
              </div>
              <div>
                <dt class="text-xs text-muted-foreground uppercase tracking-wider mb-1">Capítulos</dt>
                <dd class="text-xl font-bold text-cyan">{data.chapterCount ?? '?'}</dd>
              </div>
              <div>
                <dt class="text-xs text-muted-foreground uppercase tracking-wider mb-1">Género</dt>
                <dd class="text-xl font-bold text-purple-400">{data.genre ?? 'N/A'}</dd>
              </div>
              <div>
                <dt class="text-xs text-muted-foreground uppercase tracking-wider mb-1">Estado</dt>
                <dd class="text-xl font-bold text-green-400">{status.label}</dd>
              </div>
            </dl>
          </div>
        </div>
      </div>

      <!-- Background Glow -->
      <div class="absolute top-0 right-0 w-96 h-96 bg-gold/5 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>
    </header>

    <!-- Main Content -->
    <div class="container mx-auto px-4 py-12 max-w-4xl">
      {htmlContent ? (
        <article class="prose-wiki" aria-label="Contenido del libro">
          <div class="markdown-body" set:html={htmlContent} />
        </article>
      ) : (
        <div class="text-center py-12" role="status">
          <div class="text-6xl mb-4" aria-hidden="true">📖</div>
          <p class="text-muted-foreground text-lg">Contenido no disponible</p>
        </div>
      )}

      <!-- Navigation -->
      {(prevBook || nextBook) && (
        <nav class="mt-16 pt-8 border-t border-line" aria-label="Navegación entre libros">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {prevBook && (
              <a 
                href={`/wiki/books/${prevBook.data.slug}`} 
                class="wiki-card flex items-center gap-4 group"
                aria-label={`Libro anterior: ${prevBook.data.title}`}
              >
                <img 
                  src={prevBook.data.cover?.replace('/wiki/covers/', '/wiki/covers/webp/').replace('.jpg', '-400.webp') || '/wiki/covers/webp/placeholder-400.webp'}
                  alt=""
                  class="w-16 h-24 object-cover rounded flex-shrink-0"
                  aria-hidden="true"
                />
                <div>
                  <div class="text-xs text-muted-foreground uppercase tracking-wider mb-1">Anterior</div>
                  <div class="text-lg font-bold text-foreground group-hover:text-gold transition-colors">
                    {prevBook.data.title}
                  </div>
                  <div class="text-sm text-muted-foreground">#{String(prevBook.data.num).padStart(2, '0')}</div>
                </div>
              </a>
            )}
            {nextBook && (
              <a 
                href={`/wiki/books/${nextBook.data.slug}`} 
                class="wiki-card flex items-center gap-4 group md:text-right"
                aria-label={`Libro siguiente: ${nextBook.data.title}`}
              >
                <div class={prevBook ? "md:ml-auto" : ""}>
                  <div class="text-xs text-muted-foreground uppercase tracking-wider mb-1">Siguiente</div>
                  <div class="text-lg font-bold text-foreground group-hover:text-gold transition-colors">
                    {nextBook.data.title}
                  </div>
                  <div class="text-sm text-muted-foreground">#{String(nextBook.data.num).padStart(2, '0')}</div>
                </div>
                <img 
                  src={nextBook.data.cover?.replace('/wiki/covers/', '/wiki/covers/webp/').replace('.jpg', '-400.webp') || '/wiki/covers/webp/placeholder-400.webp'}
                  alt=""
                  class="w-16 h-24 object-cover rounded flex-shrink-0"
                  aria-hidden="true"
                />
              </a>
            )}
          </div>
        </nav>
      )}
    </div>
  </div>
</Layout>