---
import fs from 'node:fs';
import path from 'node:path';
import { marked } from 'marked';
import Base from '../layouts/Base.astro';

const chapterPath = path.resolve('public/capitulo1-observador.md');
const rawMd = fs.readFileSync(chapterPath, 'utf-8');
const chapterHtml = marked.parse(rawMd);

const ctaText = "Este es el primer capítulo de MEDIOEVO 00 — El Observador, por Claudio Cobain. La saga completa está en la tienda.";
---

<Base title="Leer gratis — MEDIOEVO 00 · El Observador" description="Lee gratis el primer capítulo de MEDIOEVO. Entra al mundo. Sin registro, sin pago.">
  <article class="mx-auto max-w-2xl">
    <header class="mb-10 text-center">
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-[var(--gold)] mb-2">Puerta libre</p>
      <h1 class="text-3xl font-bold text-white leading-tight">
        MEDIOEVO 00 &mdash; El Observador
      </h1>
      <p class="text-[var(--ink2)] text-sm mt-1">Por Claudio Cobain</p>
      <p class="font-mono text-[10px] uppercase tracking-wider text-[var(--mut)] mt-3">Capítulo 1 — Antes del primer libro</p>
    </header>

    <div class="chapter-content prose prose-invert prose-gold max-w-none
      prose-p:leading-relaxed prose-p:text-[var(--ink)] prose-p:text-base
      prose-strong:text-[var(--gold)] prose-strong:font-semibold
      prose-em:text-[var(--gold)] prose-em:italic
      prose-a:text-[var(--cyan)] prose-a:underline prose-a:underline-offset-2
      [&_h1]:hidden [&_h2]:text-lg [&_h2]:font-semibold [&_h2]:text-[var(--gold)] [&_h2]:mt-10 [&_h2]:mb-4
      [&_p]:mb-5 [&_p]:leading-[1.75]
      [&_hr]:border-[var(--line)] [&_hr]:my-8 [&_hr]:border-dashed
      [&_blockquote]:border-l-2 [&_blockquote]:border-[var(--gold)]/40 [&_blockquote]:pl-4 [&_blockquote]:text-[var(--ink2)]">
      {chapterHtml}
    </div>

    <footer class="mt-12 pt-8 border-t border-[var(--line)] text-center">
      <p class="text-[var(--ink2)] text-sm italic max-w-xl mx-auto">
        {ctaText}
      </p>
      <div class="mt-5">
        <a href="/tienda"
           class="inline-block bg-[var(--gold)] text-[var(--bg)] font-semibold px-6 py-3 rounded-lg no-underline hover:brightness-120 transition-all text-sm">
          Ir a la tienda &rarr;
        </a>
      </div>
      <p class="text-[var(--mut)] text-xs mt-4">
        &copy; Luis René González. Todos los derechos reservados.
      </p>
    </footer>
  </article>
</Base>

<style>
  .chapter-content {
    counter-reset: none;
  }
  .chapter-content > *:first-child {
    margin-top: 0;
  }
  .chapter-content > *:last-child {
    margin-bottom: 0;
  }
</style>