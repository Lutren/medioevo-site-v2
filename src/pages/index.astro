---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { getBooks } from '../lib/medioevo';
import MedioevoBracelet from '../components/MedioevoBracelet.astro';
const posts = (await getCollection('blog'))
  .filter((p) => p.data.lang === 'es')
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const latest = posts.slice(0, 4);
const books = await getBooks();
const totalBooks = books.length;
const covers = [
  { src: '/images/covers/00-observador.jpg', t: 'El Observador' },
  { src: '/images/covers/01-despertar.jpg', t: 'Despertar' },
  { src: '/images/covers/02-deriva.jpg', t: 'Deriva' },
  { src: '/images/covers/03-fragmentos.jpg', t: 'Fragmentos' },
  { src: '/images/covers/04-calibracion.jpg', t: 'Calibración' },
  { src: '/images/covers/05-transicion.jpg', t: 'Transición' },
  { src: '/images/covers/06-umbral.png', t: 'Umbral' },
  { src: '/images/covers/07-babel.jpg', t: 'Babel' },
  { src: '/images/covers/08-post-babel.jpg', t: 'Post-Babel' },
  { src: '/images/covers/09-nosotros.jpg', t: 'Nosotros, Ustedes, Los Otros' },
  { src: '/images/covers/10-le-jardin.jpg', t: 'Le Jardin' },
  { src: '/images/covers/11-frontera.jpg', t: 'Frontera' },
  { src: '/images/covers/12-don-humo.jpg', t: 'Don Humo' },
  { src: '/images/covers/13-nexus.jpg', t: 'Nexus' },
  { src: '/images/covers/17-medioevo.jpg', t: 'MEDIOEVO' },
];
const stateClass = (state: string) => {
  if (state === 'CERTEZA') return 'cert';
  if (state === 'INCÓGNITA') return 'incog';
  if (state === 'BLOQUEADO') return 'block';
  return 'inf';
};
---

<Base>
  <div class="starfield" aria-hidden="true">
    {Array.from({ length: 26 }, (_, i) => (
      <span style={`top:${Math.random()*100}%;left:${Math.random()*100}%;animation-duration:${2+Math.random()*4}s;animation-delay:${Math.random()*3}s;width:${1+Math.random()*2}px;height:${1+Math.random()*2}px`}></span>
    ))}
  </div>

  <section class="hero-section pt-14 pb-8">
    <div class="hero-glow" aria-hidden="true"></div>

    <div class="grid lg:grid-cols-[1.25fr_1fr] gap-10 lg:gap-8 items-center">
      <div>
        <h1 class="hero-title text-5xl sm:text-6xl md:text-7xl font-bold text-white leading-[1.0] tracking-tight">
          MEDIOEVO
        </h1>
        <p class="hero-sub text-xl sm:text-2xl text-[var(--gold)] mt-3 font-light">
          Hay mundos que cambian a quien los habita. Este es uno de ellos.
        </p>

        <p class="hero-desc text-[var(--ink2)] text-base sm:text-lg mt-5 leading-relaxed">
          En un futuro donde la Tierra tiene tres planos de existencia, hay ciudades que suprimen
          la consciencia para sobrevivir, observadores que perciben la realidad de maneras distintas,
          y personajes que cargan el peso de cada decisión que toman.
        </p>

        <div class="hero-cta-group flex flex-wrap gap-4 mt-8">
          <a href="/tienda" class="hero-cta bg-[var(--gold)] text-[var(--bg)] font-medium px-6 py-3 rounded-lg no-underline hover:brightness-120 transition-all">
            Ver los libros →
          </a>
          <a href="/mundo" class="hero-cta border border-[var(--cyan)] text-[var(--cyan)] px-6 py-3 rounded-lg no-underline hover:bg-[var(--cyan)] hover:text-[var(--bg)] transition-all">
            Explorar el mundo
          </a>
        </div>
      </div>

      <!-- Abanico de portadas reales (remodelación 2026-07-04) -->
      <div class="relative mx-auto lg:justify-self-end shrink-0" style="width:min(360px,88vw);height:430px" aria-hidden="true">
        <img src="/images/covers/00-observador.jpg" alt="" loading="eager" width="200" height="267"
             class="absolute rounded-xl"
             style="left:0;top:56px;width:56%;transform:rotate(-9deg);border:1px solid var(--line);box-shadow:0 18px 50px rgba(0,0,0,.55)" />
        <img src="/images/covers/17-medioevo.jpg" alt="" loading="eager" width="200" height="267"
             class="absolute rounded-xl"
             style="right:0;top:56px;width:56%;transform:rotate(9deg);border:1px solid var(--line);box-shadow:0 18px 50px rgba(0,0,0,.55)" />
        <img src="/images/covers/01-despertar.jpg" alt="" loading="eager" width="230" height="307"
             class="absolute rounded-xl"
             style="left:50%;top:0;transform:translateX(-50%);width:62%;z-index:2;border:2px solid rgba(212,160,80,.45);box-shadow:0 24px 60px rgba(0,0,0,.65),0 0 44px rgba(212,160,80,.14)" />
      </div>
    </div>
  </section>

  <!-- WORLD HOOK — 3 planos, un universo -->
  <section class="mt-6 reveal">
    <div class="rounded-2xl border border-[var(--line)] bg-[var(--surface)] p-6 sm:p-9 text-center relative overflow-hidden">
      <div class="hero-glow" aria-hidden="true"></div>
      <p class="text-lg sm:text-2xl text-[var(--ink)] leading-relaxed max-w-3xl mx-auto font-light">
        Tres planos de realidad.
        Una ciudad que sostiene el peso de todos.
        Personajes que cruzan la línea entre el ser y el percibir.
      </p>
      <div class="flex flex-wrap justify-center gap-x-10 gap-y-5 mt-8">
        <div><div class="text-4xl sm:text-5xl font-bold text-white leading-none">3</div><div class="text-xs text-[var(--mut)] uppercase tracking-[0.15em] mt-1.5">planos de existencia</div></div>
        <div><div class="text-4xl sm:text-5xl font-bold text-white leading-none">847</div><div class="text-xs text-[var(--mut)] uppercase tracking-[0.15em] mt-1.5">torres TAAT</div></div>
        <div><div class="text-4xl sm:text-5xl font-bold text-white leading-none">155</div><div class="text-xs text-[var(--mut)] uppercase tracking-[0.15em] mt-1.5">macrozonas</div></div>
        <div><div class="text-4xl sm:text-5xl font-bold text-white leading-none">{totalBooks}</div><div class="text-xs text-[var(--mut)] uppercase tracking-[0.15em] mt-1.5">libros del universo</div></div>
      </div>
      <a href="/mundo" class="inline-block mt-8 bg-[var(--gold)] text-[var(--bg)] font-semibold px-7 py-3 rounded-lg no-underline hover:brightness-120 transition-all">
        Explorar el mundo →
      </a>
    </div>
  </section>

  <!-- WORLD PREVIEW — mapa real + stats -->
  <section class="mt-10 reveal">
    <div class="section-label gold mb-5">
      <span>El Universo</span>
      <a href="/mundo" class="text-sm text-[var(--gold)] ml-auto no-underline hover:text-[var(--cyan)] transition-colors">Ver mundo completo →</a>
    </div>
    <div class="world-preview-grid">
      <div class="world-map-card">
        <img src="/images/world/plano_medio_map_v2.png" alt="Plano Medio — MEDIOEVO" class="world-map-img" loading="eager" />
        <div class="world-map-overlay">
          <span class="world-map-label">Plano Medio</span>
          <span class="world-map-sub">χ &gt; χ* · Supercrítico · 847 Torres TAAT · Ciclo 3</span>
        </div>
      </div>
      <div class="world-stats-col">
        <div class="world-stat">
          <div class="world-stat-num">3</div>
          <div class="world-stat-label">Planos de realidad</div>
        </div>
        <div class="world-stat">
          <div class="world-stat-num">847</div>
          <div class="world-stat-label">Torres TAAT en el Plano Medio</div>
        </div>
        <div class="world-stat">
          <div class="world-stat-num">{totalBooks}</div>
          <div class="world-stat-label">Libros del universo</div>
        </div>
        <a href="/mundo" class="world-explore-link">Explorar el universo →</a>
      </div>
    </div>
  </section>

  <!-- PUERTA LIBRE — lee un capítulo gratis -->
  <section class="mt-8 reveal reveal-delay-1">
    <div class="rounded-xl border border-[var(--line)] bg-[var(--surface)] p-6 text-center relative overflow-hidden">
      <div class="hero-glow" aria-hidden="true"></div>
      <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-[var(--gold)] mb-1">Puerta libre</p>
      <p class="text-sm text-[var(--ink)] max-w-lg mx-auto">
        Lee el primer capítulo de MEDIOEVO. Sin registro. Sin pago. Solo tú y el mundo.
      </p>
      <a href="/leer"
         class="inline-block mt-3 border border-[var(--gold)] text-[var(--gold)] font-medium px-5 py-2 rounded-lg no-underline hover:bg-[var(--gold)] hover:text-[var(--bg)] transition-all text-sm">
        Entra &rarr;
      </a>
    </div>
  </section>

  <!-- CITIES STRIP -->
  <section class="mt-8 reveal reveal-delay-1">
    <div class="cities-strip">
      <div class="city-thumb">
        <img src="/images/world/nexus_city_map_v2.png" alt="Nexus" loading="lazy" />
        <span class="city-thumb-name">Nexus</span>
      </div>
      <div class="city-thumb">
        <img src="/images/world/sanguisburg_city_map_v2.png" alt="Sanguisburg" loading="lazy" />
        <span class="city-thumb-name">Sanguisburg</span>
      </div>
      <div class="city-thumb">
        <img src="/images/world/plano_astral_map_v2.png" alt="Plano Astral" loading="lazy" />
        <span class="city-thumb-name">Plano Astral</span>
      </div>
    </div>
  </section>

  <!-- LOS LIBROS — portadas reales -->
  <section class="mt-10 reveal">
    <div class="section-label gold mb-5">
      <span>Los Libros</span>
      <a href="/tienda" class="text-sm text-[var(--gold)] no-underline hover:text-[var(--cyan)] transition-colors" style="margin-left:auto">Ver la tienda →</a>
    </div>
    <div class="flex gap-3 overflow-x-auto pb-3 -mx-1 px-1" style="scrollbar-width:thin;scroll-snap-type:x proximity">
      {covers.map((c) => (
        <a href="/tienda" aria-label={c.t}
           class="shrink-0 rounded-lg overflow-hidden border border-[var(--line)] hover:border-[var(--gold)] hover:shadow-[0_0_24px_rgba(212,160,80,0.10)] transition-all duration-250"
           style="width:150px;aspect-ratio:3/4;scroll-snap-align:start">
          <img src={c.src} alt={`Portada — ${c.t}`} loading="lazy" width="150" height="200" class="w-full h-full object-cover" />
        </a>
      ))}
    </div>
    <p class="text-[var(--mut)] text-xs mt-2">Estas son algunas de las portadas. Cada libro abre una puerta distinta del mundo.</p>
  </section>


  <section class="mt-14 reveal reveal-delay-1">
    <div class="section-label gold mb-6">
      <span>Entra por donde quieras</span>
    </div>
    <div class="grid md:grid-cols-2 gap-5">
      <a href="/mundo" class="pillar-card block border border-[var(--line)] rounded-xl p-6 no-underline transition-all duration-300 bg-[var(--surface)] reveal reveal-delay-1">
        <div class="pillar-icon text-3xl mb-3 text-[var(--gold)]">&#9670;</div>
        <h3 class="text-white text-lg font-semibold">Conoce el mundo</h3>
        <p class="text-[var(--ink2)] text-sm mt-2 leading-relaxed flex-1">Tres planos de realidad, cientos de ciudades, personajes que cruzan la línea entre el ser y el percibir.</p>
        <span class="inline-block mt-3 text-sm font-medium text-[var(--gold)]">Ver el mundo &rarr;</span>
      </a>
      <a href="/tienda" class="pillar-card block border border-[var(--line)] rounded-xl p-6 no-underline transition-all duration-300 bg-[var(--surface)] reveal reveal-delay-2">
        <div class="pillar-icon text-3xl mb-3 text-[var(--gold)]">&#9633;</div>
        <h3 class="text-white text-lg font-semibold">Empieza a leer</h3>
        <p class="text-[var(--ink2)] text-sm mt-2 leading-relaxed flex-1">Elige tu entrada al mundo. Cada libro es una puerta distinta. Empieza por donde quieras.</p>
        <span class="inline-block mt-3 text-sm font-medium text-[var(--gold)]">Ir a la tienda &rarr;</span>
      </a>
    </div>
  </section>

  <!-- CHARACTERS -->
  <section class="mt-14 reveal reveal-delay-2">
    <div class="section-label gold mb-6">
      <span>Personajes</span>
    </div>
    <div class="char-grid">
      <div class="char-card">
        <img src="/images/world/don_humo_character_plate_v2.png" alt="Don Humo / Xochipilli" class="char-img" loading="lazy" />
        <div class="char-info">
          <div class="char-name">Don Humo</div>
          <div class="char-alias">Xochipilli · Guía / ¿antagonista?</div>
          <p class="char-desc">¿Guía o traidor? La frontera no siempre es visible — y eso es lo que lo hace inolvidable.</p>
        </div>
      </div>
      <div class="char-card">
        <img src="/images/world/faith_nollan_character_plate_v2.png" alt="Faith Nollan" class="char-img" loading="lazy" />
        <div class="char-info">
          <div class="char-name">Faith Nollan</div>
          <div class="char-alias">Protagonista · División 47</div>
          <p class="char-desc">Sus decisiones cargan el peso de toda la saga. Lee para descubrir por qué.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="mt-14 reveal reveal-delay-4">
    <div class="section-label cyan mb-6">
      <span>Últimas entradas</span>
      <a href="/blog" class="text-sm text-[var(--cyan)] hover:text-[var(--gold)] transition-colors shrink-0 no-underline" style="margin-left:auto">Ver todas →</a>
    </div>
    <div class="grid sm:grid-cols-2 gap-4">
      {latest.map((p) => (
        <a href={`/blog/${p.id}`}
          class="bento-card no-underline">
          <div class="flex items-center gap-2 text-xs">
            <span class={`epistemic-tag ${stateClass(p.data.estado)}`}>
              {p.data.estado}
            </span>
            <span class="text-[var(--mut)]">{p.data.category}</span>
          </div>
          <div class="text-white font-medium mt-2 leading-snug">{p.data.title}</div>
          <div class="text-[var(--ink2)] text-sm mt-1.5 leading-relaxed line-clamp-2">{p.data.summary}</div>
        </a>
      ))}
      {latest.length === 0 && (
        <p class="text-[var(--mut)]">Pronto: entradas de trayectoria.</p>
      )}
    </div>
  </section>

  <!-- Desactivado en producción (hallazgo 2026-07-04): apunta a localhost:8787,
       el servidor LOCAL de Tyr -- todo visitante público ve el widget "offline"
       permanentemente porque intenta conectar a SU PROPIA máquina, no a un backend
       público real. Reactivar cuando exista un endpoint público (MOI v2 / wabi web-act). -->
  <!-- <MedioevoBracelet server-url="http://localhost:8787" default-persona="claudio" /> -->

</Base>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
      }
    });
  }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });

  document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
</script>
