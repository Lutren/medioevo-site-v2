---
import Base from '../layouts/Base.astro';
const aportes = [
  ['TokenSaver epistémico', 'CERTEZA operacional', 'Comprime contexto preservando decisiones; reduce tokens 60-70%.'],
  ['Retículo CERTEZA/INFERENCIA/INCÓGNITA/BLOQUEADO', 'CERTEZA lógica', 'Evita sobreclaims en sistemas de IA.'],
  ['Residuo noisy-OR', 'CERTEZA matemática', 'Un fallo crítico no se diluye entre aciertos.'],
  ['Gates de acción (C-GATE/GhostGate/ActionGate)', 'CERTEZA como protocolo', 'Seguridad y rollback verificables.'],
  ['Agentes locales con test + rollback', 'INFERENCIA fuerte', 'Programación offline controlada, sin dependencia cloud.'],
];
---
<Base title="Sobre mí - Luis René González">
  <h1 class="text-3xl font-bold text-gradient">Sobre mí</h1>
  <p class="text-[var(--mut)] mt-3 max-w-2xl">
    Soy <strong class="text-white">Luis René González (Lutren)</strong>, desde México. Construyo
    <strong class="text-white">MEDIOEVO</strong>,
    una saga sci-fi, y de esa obra nació <strong class="text-white">OSIT</strong>: un marco
    para que la IA trabaje con evidencia y no invente certezas. Construyo local-first, en hardware bajo
    recurso, con honestidad epistémica como principio.
  </p>

  <h2 class="text-xl font-semibold text-gradient mt-10">Concepto: cyberpunk · archeopunk</h2>
  <p class="text-[var(--mut)] mt-2 max-w-2xl">
    Me considero <strong class="text-white">cyberpunk</strong> (a mi manera, no el concepto coloquial) y
    <strong class="text-white">archeopunk</strong>. No steampunk literal, pero sí su <em>ethos</em> de
    reusar lo descartado: tomo recursos que otros <strong class="text-white">desechan, subestiman o
    ignoran</strong> y que son <strong class="text-white">prácticos, pragmáticos, eficientes y
    estables</strong>, y los hago producir. Local-first, bajo recurso, reproducible.
  </p>

  <h2 class="text-xl font-semibold text-gradient mt-10">Aportes a la ciencia (clasificados, sin sobreclaim)</h2>
  <div class="mt-4 space-y-3">
    {aportes.map(([t, e, d]) => (
      <div class="border border-[var(--line)] rounded-xl p-4 hover:border-[rgba(124,196,255,0.3)] hover:shadow-[0_0_24px_rgba(124,196,255,0.06)] transition-all duration-250">
        <div class="flex items-center gap-2"><span class="text-white font-medium">{t}</span><span class="tag">{e}</span></div>
        <div class="text-[var(--mut)] text-sm mt-1">{d}</div>
      </div>
    ))}
  </div>
  <p class="text-[var(--mut)] text-sm mt-4">Lo que sigue abierto (P vs NP, gravedad, AGI) se mantiene como <strong class="text-white">investigación</strong>, nunca como resultado demostrado.</p>

  <h2 class="text-xl font-semibold text-gradient mt-10">Redes y enlaces</h2>
    <ul class="mt-3 space-y-1 text-[var(--acc)]">
        <li><a href="https://github.com/Lutren" class="hover:text-white transition-colors">GitHub - Lutren</a></li>
        <li><a href="/tienda" class="hover:text-white transition-colors">Tienda - libros y packs</a></li>
        <li><a href="/open-source" class="hover:text-white transition-colors">Repos open source + GitHub Sponsors</a></li>
    </ul>
</Base>
