                url: 'https://lrgonzalez.gumroad.com/l/dmqgzi',
                stripe: 'https://buy.stripe.com/test_fZu4gy3WT0fa8jJd7lfbq00',
                tag: 'Libro I',
                cover: '/images/covers/01-despertar.jpg',
                productKey: 'medioevo_despertar',
            },
            {
                t: 'III: Umbral del Ciclo',
                d: 'Tercer libro. El ciclo se cierra.',
                url: 'https://lrgonzalez.gumroad.com/l/eaowrm',
                permalink: 'eaowrm',
                stripe: 'https://buy.stripe.com/test_00wdR8dxt3rmbvVfftfbq01',
                tag: 'Libro III',
            },
            {
                t: 'IV: Babel. Las Cinco Torres',
                d: 'Cinco torres, cinco voces, una verdad.',
                url: 'https://lrgonzalez.gumroad.com/l/hgmwi',
                permalink: 'hgmwi',
                stripe: 'https://buy.stripe.com/test_14A4gyctp2niarR1oDfbq02',
                tag: 'Libro IV',
            },
            {
                t: 'V: Le Jardin',
                d: 'El jardín como espacio de transición.',
                url: 'https://lrgonzalez.gumroad.com/l/medioevo-v-le-jardin',
                permalink: 'medioevo-v-le-jardin',
                stripe: 'https://buy.stripe.com/test_00w9AS50XbXSdE30kzfbq03',
                tag: 'Libro V',
            },
            {
                t: 'VI: Nexus. El Dios con Mandil',
                d: 'El nexo entre mundos.',
                url: 'https://lrgonzalez.gumroad.com/l/bnzxh',
                permalink: 'bnzxh',
                stripe: 'https://buy.stripe.com/test_9B6d88d9e602Zp4APfbq04',
                tag: 'Libro VI',
            },
        ],
    },
    {
        t: 'Universo Expandido',
        icon: '▣',
        d: 'Ensayos, companion docs, derivados del canon y material complementario.',
        productos: [
            {
                t: 'El Observacionista: Notas de un Constructor',
                d: '25 años construyendo un universo. Aquí está la bitácora.',
                url: 'https://lrgonzalez.gumroad.com/l/fuxcn',
                permalink: 'fuxcn',
                stripe: 'https://buy.stripe.com/test_7sY14mctp9PK57x3wLfbq05',
