                permalink: 'yujtrt',
                stripe: 'https://buy.stripe.com/test_bJebJ0gJF2nieI75ETfbq09',
                tag: 'Fact-Check',
                productKey: 'factcheck_bundle',
            },
        ],
    },
];

// Enrich product data with live API info
for (const line of lines) {
    for (const p of line.productos) {
        if (p.permalink) {
            const live = getLiveData(p.permalink);
            if (live) {
                // Override with live data if available
                p.url = live.url || p.url;
                if (live.description && live.description.length > 10) {
                    // Strip HTML tags for clean display
                    p.d = live.description.replace(/<[^>]*>/g, '').substring(0, 200) + (live.description.length > 200 ? '...' : '');
                }
                p.customPrice = live.price_display;
            }
        }
    }
}

const hasUrl = (p: ProductDef) => p.url && p.url.startsWith('http');
---

<Base title="Tienda - MEDIOEVO / OSIT" description="Libros, packs y herramientas MEDIOEVO: edición estándar, universo expandido y herramientas local-first.">
  <h1 class="text-3xl font-bold text-gradient">Tienda</h1>
  <p class="text-[var(--mut)] mt-2 max-w-2xl">Libros, plantillas y packs. Pago seguro con tarjeta o Gumroad.</p>

  {lines.map((line) => (
    <section class="mt-10">
      <div class="flex items-center gap-2 mb-4">
        <span class="text-xl text-[var(--gold)]">{line.icon}</span>
        <h2 class="text-xl font-semibold text-white">{line.t}</h2>
      </div>
      <p class="text-[var(--ink2)] text-sm mb-4 max-w-2xl">{line.d}</p>
      <div class="grid sm:grid-cols-2 gap-4">
        {line.productos.map((p) => (
          <div class="border border-[var(--line)] rounded-xl p-5 flex flex-col hover:border-[rgba(212,160,80,0.2)] hover:shadow-[0_0_24px_rgba(212,160,80,0.06)] transition-all duration-250 bg-[var(--surface)]">
            {p.cover && (
              <div class="mb-4 rounded-lg overflow-hidden border border-[var(--line)] bg-[var(--bg)]" style="aspect-ratio:3/4">
                <img src={p.cover} alt={`Portada - ${p.t}`} loading="lazy" width="400" height="533" class="w-full h-full object-cover" />
              </div>
            )}
            <span class="tag self-start">{p.tag}</span>
            <div class="text-white text-base font-medium mt-2 leading-snug">{p.t}</div>
            <div class="text-[var(--mut)] text-sm mt-1 flex-1">{p.d}</div>
            {p.customPrice && (
              <div class="text-[var(--gold)] font-semibold mt-2 text-sm">{p.customPrice}</div>
            )}
            <div class="mt-4 flex flex-col gap-2">
              {p.stripe && (
                <a href={p.stripe} target="_blank" rel="noopener" class="inline-block bg-[var(--gold)] text-[var(--bg)] font-medium px-4 py-2 rounded-lg no-underline hover:brightness-120 transition-all text-center text-sm">
                  Comprar con tarjeta
                </a>
              )}
              {hasUrl(p) ? (
                <a href={p.url} target="_blank" rel="noopener" class="inline-block border border-[var(--gold)] text-[var(--gold)] font-medium px-4 py-2 rounded-lg no-underline hover:brightness-120 transition-all text-center text-sm">
                  Comprar en Gumroad
                </a>
              ) : (
                <span class="inline-block border border-[var(--mut)] text-[var(--mut)] px-4 py-2 rounded-lg text-sm text-center">
                  Próximamente
                </span>
              )}
            </div>
          </div>
        ))}
      </div>
    </section>
  ))}

  {stripeTest && (
    <div class="mt-8 border border-[var(--cyan)] rounded-xl p-4 text-sm text-[var(--mut)]">
      <strong class="text-white">Checkout con tarjeta (Stripe) - modo prueba.</strong> Los pagos con
      tarjeta están en modo de prueba: <strong class="text-white">ningún cargo es real</strong>.
      Usa la tarjeta de prueba <code class="bg-[var(--line)] px-1 rounded">4242 4242 4242 4242</code> con cualquier fecha CVV.
    </div>
  )}

  <p class="text-[var(--mut)] text-xs mt-10">
    ¿Buscas el código abierto? Visita <a href="/open-source" class="text-[var(--cyan)] hover:text-white transition-colors">Open Source</a>.
  </p>
</Base>
