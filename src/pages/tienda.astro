                d: 'Clasifica afirmaciones en CERTEZA/INFERENCIA/INCÓGNITA/BLOQUEADO. 50 verificaciones incluidas.',
                url: 'https://lrgonzalez.gumroad.com/l/ucnkl',
                permalink: 'ucnkl',
                stripe: 'https://buy.stripe.com/test_eVqbJ0bpl3rmarR3wLfbq07',
                tag: 'Fact-Check',
