---
import fs from 'node:fs';
import path from 'node:path';
import Base from '../layouts/Base.astro';

const stripeTest = import.meta.env.PUBLIC_STRIPE_TEST_MODE === '1';

// ------------------------------------------------------------------
// Load live Gumroad API data (store_api.json) enriched with descriptions
// ------------------------------------------------------------------
interface ApiProduct {
    name: string;
    price_cents: number;
    price_display: string;
    currency: string;
    published: boolean;
    description: string;
    url: string;
    permalink: string;
    sales_count: number;
}

interface StoreApi {
    fetched_at: string;
    products: ApiProduct[];
    by_permalink: Record<string, ApiProduct>;
    total_published: number;
}

let storeApi: StoreApi | null = null;
try {
    const apiPath = path.resolve('public/store_api.json');
    if (fs.existsSync(apiPath)) {
        storeApi = JSON.parse(fs.readFileSync(apiPath, 'utf-8'));
    }
} catch (e) {
    console.warn('store_api.json not found or invalid, using fallback data');
}

// Helper: get live data by permalink
function getLiveData(permalink: string): ApiProduct | undefined {
    if (!storeApi) return undefined;
    return storeApi.by_permalink?.[permalink] || storeApi.products?.find(p => p.permalink === permalink);
}

// Helper: format price
function formatPrice(cents: number): string {
    return `$${(cents / 100).toFixed(2)} USD`;
}

// ------------------------------------------------------------------
// Product definitions with Gumroad permalink mapping
// ------------------------------------------------------------------
interface ProductDef {
    t: string;           // title
    d: string;           // description
    url: string;         // fallback URL
    permalink?: string;    // Gumroad permalink for live data lookup
    stripe?: string;       // Stripe payment link
    tag: string;
    cover?: string;
    productKey?: string;
    customPrice?: string; // override price display
}

interface LineDef {
    t: string;           // section title
    icon: string;
    d: string;           // section description
    productos: ProductDef[];
}

const lines: LineDef[] = [
    {
