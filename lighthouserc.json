{
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "startServerCommand": "npx http-server ./dist -p 4321 -s",
      "url": [
        "http://localhost:4321/wiki",
        "http://localhost:4321/wiki/books",
        "http://localhost:4321/wiki/books/00-el-observador",
        "http://localhost:4321/wiki/atlas",
        "http://localhost:4321/wiki/systems"
      ],
      "settings": {
        "preset": "desktop",
        "headless": true,
        "chromeFlags": "--no-sandbox --disable-gpu --disable-dev-shm-usage"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.7 }],
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["warn", { "minScore": 0.8 }],
        "categories:seo": ["warn", { "minScore": 0.8 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}